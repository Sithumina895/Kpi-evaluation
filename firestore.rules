rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) && getUserRole() == 'super_admin';
    }

    function isActiveUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserProfile().active == true;
    }

    function isDeptHead(deptId) {
      return isActiveUser() && getUserRole() == 'dept_head' && (getUserProfile().departmentId == deptId || isSuperAdmin());
    }

    function canAccessDept(deptId) {
      return isActiveUser() && (isSuperAdmin() || getUserProfile().departmentId == deptId);
    }

    // --- Departments ---
    match /departments/{departmentId} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin() && isValidId(departmentId);
    }

    // --- Department Objectives ---
    match /departmentObjectives/{objectiveId} {
      allow read: if isActiveUser();
      allow create, update: if isValidId(objectiveId) && (isSuperAdmin() || isDeptHead(request.resource.data.departmentId));
      allow delete: if isValidId(objectiveId) && (isSuperAdmin() || isDeptHead(resource.data.departmentId));
    }

    // --- User Profiles ---
    match /users/{uid} {
      allow read: if isActiveUser() && (request.auth.uid == uid || isSuperAdmin());
      // Only super admin can create or modify profiles (except self login timestamp)
      allow create: if isSuperAdmin() || !exists(/databases/$(database)/documents/userRoles/$(request.auth.uid));
      allow update: if isSuperAdmin() || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']));
      allow delete: if isSuperAdmin();
    }

    // --- User Roles (Separate collection) ---
    match /userRoles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // --- Employees ---
    match /employees/{employeeId} {
      allow read: if isActiveUser() && (isSuperAdmin() || canAccessDept(resource.data.departmentId));
      allow create, update: if isValidId(employeeId) && (isSuperAdmin() || isDeptHead(request.resource.data.departmentId));
      allow delete: if isSuperAdmin();
    }

    // --- KPI Templates ---
    match /kpiTemplates/{templateId} {
      allow read: if isActiveUser();
      allow create, update: if isValidId(templateId) && (isSuperAdmin() || isDeptHead(request.resource.data.departmentId));
      allow delete: if isValidId(templateId) && (isSuperAdmin() || isDeptHead(resource.data.departmentId));
    }

    // --- Evaluations ---
    match /evaluations/{evaluationId} {
      allow read: if isActiveUser() && (isSuperAdmin() || canAccessDept(resource.data.departmentId));
      
      // Evaluators and Dept Heads can create drafts/submitted
      allow create: if isValidId(evaluationId) && isActiveUser() &&
        (isSuperAdmin() || (canAccessDept(request.resource.data.departmentId) && getUserRole() in ['dept_head', 'evaluator']));
      
      // Updates:
      // 1. Super Admin can update or reopen anything
      // 2. Drafts can be edited by evaluators in the same department
      // 3. Dept Heads can approve submitted evaluations
      // 4. Submitted/Approved evaluations are locked for regular users
      allow update: if isValidId(evaluationId) && isActiveUser() && (
        isSuperAdmin() ||
        (
          canAccessDept(resource.data.departmentId) &&
          resource.data.status in ['draft', 'reopened'] &&
          getUserRole() in ['dept_head', 'evaluator'] &&
          request.resource.data.departmentId == resource.data.departmentId
        ) ||
        (
          canAccessDept(resource.data.departmentId) &&
          getUserRole() == 'dept_head' &&
          resource.data.status == 'submitted' &&
          request.resource.data.status == 'approved' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt', 'updatedAt'])
        )
      );

      allow delete: if isSuperAdmin() || (
        isActiveUser() &&
        canAccessDept(resource.data.departmentId) &&
        resource.data.status in ['draft', 'reopened'] &&
        getUserRole() in ['dept_head', 'evaluator']
      );
    }

    // --- Settings (Grade Bands) ---
    match /settings/{settingId} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin();
    }

    // --- Audit Log (Append-only) ---
    match /auditLog/{logId} {
      allow read: if isActiveUser() && (isSuperAdmin() || getUserRole() == 'dept_head');
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false; // Append-only
    }
  }
}
