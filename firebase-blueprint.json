{
  "entities": {
    "Department": {
      "title": "Department",
      "description": "Hospital clinical or non-clinical operational department",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 16 },
        "name": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["clinical", "non_clinical"] },
        "colour": { "type": "string", "maxLength": 32 },
        "icon": { "type": "string", "maxLength": 64 },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "code", "name", "type", "colour", "active"]
    },
    "DepartmentObjective": {
      "title": "DepartmentObjective",
      "description": "Department strategic BSC objective",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "text": { "type": "string", "maxLength": 500 },
        "bscCategory": { "type": "string", "enum": ["financial", "customer", "internal_process", "learning_growth", "individual_performance"] },
        "order": { "type": "number" }
      },
      "required": ["id", "departmentId", "text", "bscCategory"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Hospital user identity and assigned department",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "lastLogin": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "name", "email", "departmentId", "active"]
    },
    "UserRoleRecord": {
      "title": "UserRoleRecord",
      "description": "Isolated role assignment for ABAC enforcement",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["super_admin", "dept_head", "evaluator", "viewer"] }
      },
      "required": ["uid", "role"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Hospital employee profile",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "designation": { "type": "string", "maxLength": 128 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 128 },
        "joinDate": { "type": "string", "maxLength": 32 },
        "active": { "type": "boolean" },
        "avatarUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["employeeId", "name", "designation", "departmentId", "email", "active"]
    },
    "KPITemplate": {
      "title": "KPITemplate",
      "description": "Standardized KPI template for department BSC evaluations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "bscCategory": { "type": "string", "enum": ["financial", "customer", "internal_process", "learning_growth", "individual_performance"] },
        "kpiName": { "type": "string", "maxLength": 200 },
        "target": { "type": "string", "maxLength": 100 },
        "unit": { "type": "string", "maxLength": 64 },
        "order": { "type": "number" }
      },
      "required": ["id", "departmentId", "bscCategory", "kpiName", "target"]
    },
    "Evaluation": {
      "title": "Evaluation",
      "description": "Balanced Scorecard employee evaluation record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 64 },
        "employeeName": { "type": "string", "maxLength": 128 },
        "designation": { "type": "string", "maxLength": 128 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "evaluatorId": { "type": "string", "maxLength": 128 },
        "evaluatorName": { "type": "string", "maxLength": 128 },
        "evaluatorRole": { "type": "string", "enum": ["super_admin", "dept_head", "evaluator", "viewer"] },
        "periodType": { "type": "string", "enum": ["monthly", "quarterly", "annual"] },
        "periodStart": { "type": "string", "maxLength": 32 },
        "periodEnd": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["draft", "submitted", "approved", "reopened"] },
        "finalScore": { "type": "number" },
        "grade": { "type": "string", "maxLength": 64 },
        "strengths": { "type": "string", "maxLength": 2000 },
        "improvements": { "type": "string", "maxLength": 2000 },
        "comments": { "type": "string", "maxLength": 2000 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "approvedAt": { "type": "string", "maxLength": 64 },
        "reopenedBy": { "type": "string", "maxLength": 128 },
        "reopenedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "employeeId", "departmentId", "evaluatorId", "periodType", "status", "finalScore", "grade"]
    },
    "GradeBandSettings": {
      "title": "GradeBandSettings",
      "description": "Hospital grade score configuration",
      "type": "object",
      "properties": {
        "bands": { "type": "array" }
      },
      "required": ["bands"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable append-only audit trail record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "enum": ["create", "update", "submit", "approve", "reopen", "delete", "user_role_change", "login"] },
        "entity": { "type": "string", "enum": ["evaluation", "employee", "user", "department", "kpi_template", "settings"] },
        "entityId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "departmentId": { "type": "string", "maxLength": 64 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "action", "entity", "entityId", "userId", "departmentId", "details", "timestamp"]
    }
  },
  "firestore": {
    "/departments/{departmentId}": {
      "schema": "#/entities/Department",
      "description": "Registered hospital departments"
    },
    "/departmentObjectives/{objectiveId}": {
      "schema": "#/entities/DepartmentObjective",
      "description": "Strategic department objectives"
    },
    "/users/{uid}": {
      "schema": "#/entities/UserProfile",
      "description": "User profiles"
    },
    "/userRoles/{uid}": {
      "schema": "#/entities/UserRoleRecord",
      "description": "User RBAC role mappings"
    },
    "/employees/{employeeId}": {
      "schema": "#/entities/Employee",
      "description": "Hospital employees eligible for BSC KPI evaluation"
    },
    "/kpiTemplates/{templateId}": {
      "schema": "#/entities/KPITemplate",
      "description": "Pre-configured departmental BSC KPI templates"
    },
    "/evaluations/{evaluationId}": {
      "schema": "#/entities/Evaluation",
      "description": "Completed and in-progress BSC employee evaluations"
    },
    "/settings/gradeBands": {
      "schema": "#/entities/GradeBandSettings",
      "description": "System-wide grade boundary definitions"
    },
    "/auditLog/{logId}": {
      "schema": "#/entities/AuditLogEntry",
      "description": "Append-only security audit trail"
    }
  }
}
